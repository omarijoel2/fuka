# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
# un-ignore the built kafu-foundation frontend — these files are deployed directly
# to the server via git pull, so the production build must be tracked in git.
!artifacts/kafu-foundation/dist/
!artifacts/kafu-foundation/dist/**
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

# Deployment bundles — generated locally, not committed
*.zip

# Environment config — each environment keeps its own .env locally.
# Never commit actual .env files; only commit .env.example templates.
.env
.env.local
.env.*.local
# Catch accidental editor-temp env files (e.g. .envaMA, .envnano.save)
.env[^.e]*
artifacts/kafu-api/.env
artifacts/kafu-cms/.env
artifacts/kafu-foundation/.env
artifacts/kafu-staff/.env

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
