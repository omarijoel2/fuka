# ── KAFU Foundation (main website) ──────────────────────────────────────────
#
# VITE_API_URL — the origin of the API/storage server.
#
# Dev (Replit):   Leave empty. The Vite dev-server proxy forwards /storage/
#                 to the local PHP server automatically.
#
# Production:     Set to the API subdomain so that storage file links resolve
#                 correctly. The frontend is at kafu.ac.ke; the API and its
#                 storage symlink are at api.kafu.ac.ke.
#
#   VITE_API_URL=https://api.kafu.ac.ke
#
VITE_API_URL=
