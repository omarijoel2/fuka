# ── KAFU Foundation (main website) ──────────────────────────────────────────
#
# VITE_API_URL — the origin of the API/storage server.
#
# Dev (Replit):   Leave empty. The Vite dev-server proxy forwards /storage/
#                 to the local PHP server automatically.
#
# Production:     Leave empty. The frontend and API share kafu.ac.ke.
#                 Storage files are served via an Apache Alias:
#                   Alias /storage /home/kafu/kafu-platform/artifacts/kafu-api/storage/app/public
#                 The .htaccess excludes /storage/ from the SPA fallback.
#
VITE_API_URL=
