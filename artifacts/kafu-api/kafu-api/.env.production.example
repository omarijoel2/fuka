##############################################################################
# KAFU API — Production Environment Template
# Copy to .env on the live server and fill in every value marked <CHANGE ME>
# Run: php artisan key:generate   (generates APP_KEY)
#      php artisan config:cache
#      php artisan route:cache
##############################################################################

APP_NAME="KAFU API"
APP_ENV=production
APP_KEY=                          # Run: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.kafu.ac.ke

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Increase to 13–14 for production hardware if performance allows
BCRYPT_ROUNDS=12

##############################################################################
# Logging — keep errors only; never use debug in production
##############################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

##############################################################################
# Database — MySQL/MariaDB on university cPanel hosting
##############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kafu_website        # <CHANGE ME>
DB_USERNAME=kafu_db_user        # <CHANGE ME>
DB_PASSWORD=                    # <CHANGE ME>

##############################################################################
# Session — hardened for HTTPS production
##############################################################################
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.kafu.ac.ke
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

##############################################################################
# CORS — restrict to known front-end origins only
##############################################################################
CORS_ALLOWED_ORIGINS=https://www.kafu.ac.ke,https://cms.kafu.ac.ke,https://staff.kafu.ac.ke

##############################################################################
# Queue / Broadcasting / Cache
##############################################################################
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

##############################################################################
# Mail — configure university SMTP relay
##############################################################################
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=mail.kafu.ac.ke       # <CHANGE ME>
MAIL_PORT=587
MAIL_USERNAME=                  # <CHANGE ME>
MAIL_PASSWORD=                  # <CHANGE ME>
MAIL_FROM_ADDRESS="info@kafu.ac.ke"
MAIL_FROM_NAME="Kaimosi Friends University"
