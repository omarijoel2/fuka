# ─────────────────────────────────────────────────────────────────────────────
# KAFU API — Environment Configuration Template
# Copy this file to .env and fill in all values before running the application.
# Do NOT commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="KAFU API"
APP_ENV=production          # local | staging | production
APP_KEY=base64:GTqdnybs17E3Ct2GZZEQEiGuUQKFw6SimhfPSE6KHZg=                    # Run: php artisan key:generate
APP_DEBUG=false             # Set to false in production
APP_URL=https://api.kafu.ac.ke   # Full base URL — use http:// until SSL is configured

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning           # debug | info | warning | error (use warning/error in production)

# ─── Database — MySQL / MariaDB ───────────────────────────────────────────────
# University cPanel hosting typically provides a MySQL database.
# Create a database and user via cPanel → MySQL Databases, then fill in below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1           # Usually 127.0.0.1 on cPanel shared hosting
DB_PORT=3306
DB_DATABASE=kafu    # Database name created in cPanel (often prefixed: kafuuser_kafu_website)
DB_USERNAME=kafu    # MySQL user created in cPanel
DB_PASSWORD=                # Strong password set in cPanel
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# For MariaDB hosting, change DB_CONNECTION=mariadb (same credentials format)

# ─── Session & Cache ──────────────────────────────────────────────────────────
SESSION_DRIVER=file         # file | database | redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=kafu.difbac.com
SESSION_SECURE_COOKIE=false  # set true only when HTTPS is configured

CACHE_STORE=file            # file | database | redis

# ─── Queue ────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=sync       # sync (no worker needed) | database | redis

# ─── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls             # tls | ssl
MAIL_HOST=mail.kafu.ac.ke   # SMTP host from university mail server
MAIL_PORT=587               # 587 (TLS) or 465 (SSL)
MAIL_USERNAME=              # University email account
MAIL_PASSWORD=              # Email account password
MAIL_FROM_ADDRESS="noreply@kafu.ac.ke"
MAIL_FROM_NAME="Kaimosi Friends University"

# ─── Filesystem ───────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local       # local | s3

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use http:// until SSL is set up.
# All three portals share the same domain in the current setup.
CORS_ALLOWED_ORIGINS=http://kafu.difbac.com
